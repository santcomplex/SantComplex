// use prisma-8

model Business {
  id          String   @id @default(uuid())
  name        String
  category    String
  floor       String
  unit        String?
  logoUrl     String?
  description String?
  contactInfo String?
  isHidden    Boolean  @default(false)
  createdAt   temporal.createdAt()
  updatedAt   temporal.updatedAt()
}

model Space {
  id           String   @id @default(uuid())
  unitNumber   String   @unique
  floor        String
  area         String?
  monthlyRent  Float?
  status       SpaceStatus @default(AVAILABLE)
  basicFacilities String?
  photoUrl     String?
  createdAt    temporal.createdAt()
  updatedAt    temporal.updatedAt()
}

enum SpaceStatus {
  AVAILABLE
  OCCUPIED
}

model GalleryImage {
  id          String   @id @default(uuid())
  url         String
  category    String?  // e.g., Exterior, Interior, Parking
  description String?
  createdAt   temporal.createdAt()
}

model Enquiry {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  message   String
  status    String   @default("NEW") // NEW, READ, ARCHIVED
  createdAt temporal.createdAt()
}
